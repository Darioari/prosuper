<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirecionar www para sem www com HTTPS
  RewriteCond %{HTTP_HOST} ^www\.prosuperconsultoria\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://prosuperconsultoria.com.br/$1 [R=301,L]

  # 2. Redirecionar /index ou /index.html para raiz (/)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(index|index\.html)(\?[^\ ]*)?\ HTTP/ [NC]
  RewriteRule ^index(\.html)?$ https://prosuperconsultoria.com.br/ [R=301,L]

  # 3. Redirecionar requisições com extensão .html para a URL amigável sem .html
  # Ex: /consultor.html -> /consultor
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^?\ ]+)\.html(\?[^\ ]*)?\ HTTP/ [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 4. Remover barra final de arquivos para padronizar
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s]
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # 5. Reescrever internamente URLs amigáveis para o arquivo .html real
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# Tipos MIME
<IfModule mod_mime.c>
  AddType text/html;charset=UTF-8 .html
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
